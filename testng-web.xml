<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Ecommerce Web Suite" verbose="1">

    <test name="Web Tests">
        <!-- The tag filter is declared on WebTestRunner's @CucumberOptions
             instead of here - a TestNG <parameter> isn't read by Cucumber's
             tag filter, so this used to have no effect. -->
        <classes>
            <class name="com.ecommerce.web.runner.WebTestRunner"/>
        </classes>
    </test>

</suite>
